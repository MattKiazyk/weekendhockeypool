{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "weekend-hockey-pool",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-27",
  // Keep the existing Worker and old hostname; the edge redirect is configured separately.
  "routes": [
    { "pattern": "weeklypools.ca", "custom_domain": true },
    { "pattern": "api.weeklypools.ca", "custom_domain": true },
    { "pattern": "pool.mattkiazyk.com", "custom_domain": true },
    { "pattern": "hockey.mattkiazyk.com", "custom_domain": true },
  ],
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application",
  },
  "ratelimits": [
    { "name": "API_IP_LIMIT", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
    { "name": "API_READ_LIMIT", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } },
    { "name": "API_WRITE_LIMIT", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } },
    { "name": "API_KEY_LIMIT", "namespace_id": "1004", "simple": { "limit": 5, "period": 60 } },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hockey-pool",
      "database_id": "2ac78f44-5754-4419-84a1-86667857b63a",
      "migrations_dir": "migrations",
    },
  ],
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["noreply@weeklypools.ca"] }],
  "vars": {
    "EMAIL_ENABLED": "false",
    "EMAIL_LAUNCH_AT": "",
    "CLERK_NATIVE_AUTHORIZED_PARTIES": "https://weeklypools.ca",
  },
  "triggers": { "crons": ["*/15 * * * *"] },
}
